# API Configuration
NEXT_PUBLIC_API_URL=<Admin BE base URL including /v1, e.g. http://localhost:6001/v1>

# Identity Service Configuration
NEXT_PUBLIC_IDENTITY_SERVICE_API_BASE_URL=<Identity API URL>

# Merit Admin Service Configuration
NEXT_PUBLIC_API_URL=<Admin API URL>

# Seller Portal Service Configuration
NEXT_PUBLIC_SELLER_PORTAL_API_BASE_URL=<Seller Portal API URL>

#Merit Unified Login Module Configuration
NEXT_PUBLIC_ACCOUNTS_URL=<Accounts URL for unified login>

# Storefront public URL configuration
NEXT_PUBLIC_STOREFRONT_APP_ROOT_DOMAIN=
NEXT_PUBLIC_ENVIRONMENT=

# Firebase Configuration (you'll need to add these from your Firebase project)
NEXT_PUBLIC_FIREBASE_API_KEY=<Firebase API Key>
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=<Firebase Auth Domain>
NEXT_PUBLIC_FIREBASE_PROJECT_ID=<Firebase Project ID>
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=<Firebase Storage Bucket>
NEXT_PUBLIC_FIREBASE_APP_ID=<Firebase App ID>
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=<Firebase Messaging Sender ID>
